# Non-secret deployment settings. Keep credentials in deploy/secrets/.
AUTOSOCIAL_DOMAIN=autosocial.example.com
TZ=Asia/Qyzylorda
# Keep false until local schedulers are paused and cloud data has been checked.
AUTOSOCIAL_START_BACKGROUND=false
DASHBOARD_PUBLIC_URL=
OLLAMA_MODEL=qwen2.5:3b
AUTOSOCIAL_IMAGE=autosocial:cloud
# Replace these tags with immutable registry digests after pulling on the target.
OLLAMA_IMAGE=ollama/ollama:latest
CADDY_IMAGE=caddy:2
