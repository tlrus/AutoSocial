# Non-secret deployment settings. Keep credentials in deploy/secrets/.
AUTOSOCIAL_DOMAIN=autosocial.example.com
TZ=Asia/Qyzylorda
# Keep false until local schedulers are paused and cloud data has been checked.
AUTOSOCIAL_START_BACKGROUND=false
# Use the exact permanent HTTPS origin without a path or trailing slash.
# Required for official social API OAuth callbacks and the web deployment.
DASHBOARD_PUBLIC_URL=https://autosocial.example.com
OLLAMA_MODEL=qwen2.5:3b
AUTOSOCIAL_IMAGE=autosocial:cloud
# Replace these tags with immutable registry digests after pulling on the target.
OLLAMA_IMAGE=ollama/ollama:latest
CADDY_IMAGE=caddy:2

# deploy/compose.web.yaml runs only the app and Caddy, without Ollama.
# Keep the password hash in deploy/secrets/dashboard-password-hash.
# Put provider settings below in deploy/secrets/runtime.env, NOT this file.
# Supply only the providers you plan to connect; never commit real values.
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_API_VERSION=v23.0
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
